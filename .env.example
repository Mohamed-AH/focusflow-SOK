# --- FocusFlow environment variables ---
# Every variable is OPTIONAL: with none set, the app runs in
# localStorage-only mode (no sign-in, no cloud sync, no admin dashboard).

# Base URL of the deployment (required for OAuth in production)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# MongoDB Atlas free tier (M0) connection string
MONGODB_URI=
MONGODB_DB=focusflow

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated emails that get access to /admin
ADMIN_EMAILS=you@example.com
